# Copy this to .env and fill in your keys.  .env is gitignored - never commit it.

# --- Required ---
# Google AI Studio: https://aistudio.google.com/apikey
# Free tier on this project measures at 20 requests/day PER MODEL; quota pools are
# per-model, which is why config.py defaults to the newest flash + a fallback chain.
GEMINI_API_KEY=your_gemini_api_key_here
# Riot dev key - EXPIRES EVERY 24h, regenerate at https://developer.riotgames.com
# All fetch scripts resume from data/riot/discovery_state.json after an expiry.
RIOT_API_KEY=your_riot_api_key_here

# --- Optional: backup LLM provider (50 free requests/day) ---
# Switch per-run with:  $env:LLM_PROVIDER='openrouter'
# Free model ids rotate; list them at GET https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Override the provider/model without editing config.py:
# LLM_PROVIDER=openrouter
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# JUDGE_MODEL=gemini-3-flash-preview

# --- Optional: unused by default ---
# Paid Gemini key. Deliberately NOT wired into the code (free-tier-first policy).
# Setting it here changes nothing until someone wires it up on purpose.
GEMINI_PAID_API_KEY=
# Only needed for the (stale, single-user) app/discord_bot.py
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Only needed if you switch LLM_PROVIDER to "openai"
OPENAI_API_KEY=your_openai_api_key_here
